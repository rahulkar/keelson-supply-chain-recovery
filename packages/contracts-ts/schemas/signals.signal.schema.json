                      "type": "array"
                    },
                    "minItems": 4,
                    "type": "array"
                  },
                  "minItems": 1,
                  "title": "Coordinates",
                  "type": "array"
                },
                "type": {
                  "const": "Polygon",
                  "title": "Type",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "title": "Polygon",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "coordinates": {
                  "items": {
                    "items": {
                      "items": {
                        "maxItems": 2,
                        "minItems": 2,
                        "prefixItems": [
                          {
                            "maximum": 180,
                            "minimum": -180,
                            "type": "number"
                          },
                          {
                            "maximum": 90,
                            "minimum": -90,
                            "type": "number"
                          }
                        ],
                        "type": "array"
                      },
                      "minItems": 4,
