      "title": "Geometry"
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "natural_hazard",
        "weather",
        "geopolitical",
        "labor",
        "logistics",
        "regulatory",
        "cyber",
        "supplier",
        "demand",
        "hypothetical"
      ],
      "title": "Kind",
      "type": "string"
    },
    "location_refs": {
      "items": {
        "pattern": "^(UNLOCODE|ISO3166|CHOKEPOINT|REGION|SUPPLIER|FACTORY|DC|STORE|LANE):[A-Za-z0-9._>-]{1,64}$",
        "type": "string"
      },
      "maxItems": 200,
      "title": "Location Refs",
      "type": "array"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "origin": {
      "enum": [
        "feed",
        "news",
        "connected_system",
        "chat",
        "demo"
      ],
      "title": "Origin",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "fact",
        "inference",
        "simulated"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "raw_text": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Text"
    },
    "severity_bp": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Severity Bp",
      "type": "integer"
    },
    "severity_native": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "The source's own severity terms, kept for display/audit: ``{scheme, …}``.\n\n``scheme`` names the vocabulary (``gdacs``, ``usgs``, ``none`` …); the other keys are JSON\nscalars (e.g. ``alertlevel: \"red\"``, ``alertscore: 2.5``, ``mag: 6.8``, ``tsunami: false``).\nNever hashed; floats are allowed here.",
      "properties": {
        "scheme": {
          "pattern": "^[a-z][a-z0-9_.-]{0,31}$",
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "scheme"
      ],
      "title": "SeverityNative",
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "description": "Attribution of a signal (shown with its licence in the alert drawer).",
      "properties": {
        "authority_bp": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Authority Bp",
          "type": "integer"
        },
        "connector_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Connector Id",
          "type": "string"
        },
        "license": {
          "maxLength": 120,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "native_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Native Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\x00-\\x20\\x7f\\\\]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "connector_id",
        "name",
        "url",
        "license",
        "authority_bp",
        "retrieved_at",
        "native_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "starts_at": {
      "format": "date-time",
      "title": "Starts At",
      "type": "string"
    },
    "subtype": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Subtype",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Summary"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Supersedes"
    },
    "tenant": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "tenant",
    "origin",
    "kind",
    "subtype",
    "title",
    "summary",
    "raw_text",
    "geometry",
    "location_refs",
    "starts_at",
    "ends_at",
    "observed_at",
    "expires_at",
    "severity_bp",
    "severity_native",
    "confidence_bp",
    "provenance",
    "extracted_by",
    "source",
    "event_id",
    "version",
    "supersedes"
  ],
  "title": "DisruptionSignal",
  "type": "object",
  "x-keelson-source": "keelson_contracts.signals.DisruptionSignal"
}
