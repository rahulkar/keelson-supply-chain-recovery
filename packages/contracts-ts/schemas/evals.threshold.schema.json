{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A target (never a gate): ``op: min`` = actual ≥ value, ``max`` = actual ≤ value.",
  "properties": {
    "metric": {
      "enum": [
        "pass_rate_bp",
        "adversarial_pass_rate_bp",
        "entity_recall_mean_bp",
        "numeric_grounding_min_bp",
        "trajectory_recall_mean_bp",
        "first_stage_p50_ms",
        "exposure_max_ms",
        "options_max_ms",
        "tokens_per_case_mean",
        "cost_per_case_mean_microusd"
      ],
      "title": "Metric",
      "type": "string"
    },
    "modes": {
      "items": {
        "enum": [
          "replay",
          "record_or_replay",
          "record",
          "unknown"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Modes",
      "type": "array"
    },
    "op": {
      "enum": [
        "min",
        "max"
      ],
      "title": "Op",
      "type": "string"
    },
    "value": {
      "minimum": 0,
      "title": "Value",
      "type": "integer"
    }
  },
  "required": [
    "metric",
    "op",
    "value",
    "modes"
  ],
  "title": "EvalThreshold",
  "type": "object",
  "x-keelson-source": "keelson_contracts.evals.EvalThreshold"
}
