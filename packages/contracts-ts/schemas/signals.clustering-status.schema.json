{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``GET /v1/clustering``: settings, backends and the window's counts.",
  "properties": {
    "config": {
      "additionalProperties": false,
      "description": "Platform-wide clustering settings (one versioned row on the hub; global feeds cluster once\nfor every tenant, so no tenant can change them). Immutable: the default is module state.",
      "properties": {
        "simhash": {
          "additionalProperties": false,
          "description": "Near-duplicate detection of news items (64-bit SimHash over headline + snippet).\n\n``max_hamming_bits`` <= 7 keeps the 8 x 8-bit band index exact (any pair within 7 bits shares\na band); ``reuse_extraction`` lets a cross-source copy that names every entity of its original\nreuse the original's extraction (no LLM call) after its own pattern screen.",
          "properties": {
            "enabled": {
              "title": "Enabled",
              "type": "boolean"
            },
            "max_hamming_bits": {
              "maximum": 7,
              "minimum": 0,
              "title": "Max Hamming Bits",
              "type": "integer"
            },
            "reuse_extraction": {
              "title": "Reuse Extraction",
              "type": "boolean"
            },
            "window_hours": {
              "maximum": 168,
              "minimum": 1,
              "title": "Window Hours",
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "max_hamming_bits",
            "window_hours",
            "reuse_extraction"
          ],
          "title": "SimHashSettings",
          "type": "object"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated At"
        },
        "updated_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Updated By"
        },
        "vector": {
          "additionalProperties": false,
          "description": "Vector attach / merge (clustering v2). ``local`` thresholds apply to the deterministic term\nvectors (ingest and replay), ``remote`` to an opt-in embedding profile (background merges).",
          "properties": {
            "enabled": {
              "title": "Enabled",
              "type": "boolean"
            },
            "local": {
              "additionalProperties": false,
              "description": "Similarity thresholds of one profile (basis points of cosine similarity):\n``attach_bp`` joins a signal to an event v1 could not place; ``merge_bp`` merges two candidate\nevents; ``strict_bp`` applies when there is no geometry on one side and no shared country.",
              "properties": {
                "attach_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Attach Bp",
                  "type": "integer"
                },
                "merge_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Merge Bp",
                  "type": "integer"
                },
                "strict_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Strict Bp",
                  "type": "integer"
                }
              },
              "required": [
                "attach_bp",
                "merge_bp",
                "strict_bp"
              ],
              "title": "VectorThresholds",
              "type": "object"
            },
            "max_distance_km": {
              "maximum": 3000,
              "minimum": 50,
              "title": "Max Distance Km",
              "type": "integer"
            },
            "remote": {
              "additionalProperties": false,
              "description": "Similarity thresholds of one profile (basis points of cosine similarity):\n``attach_bp`` joins a signal to an event v1 could not place; ``merge_bp`` merges two candidate\nevents; ``strict_bp`` applies when there is no geometry on one side and no shared country.",
              "properties": {
                "attach_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Attach Bp",
                  "type": "integer"
                },
                "merge_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Merge Bp",
                  "type": "integer"
                },
                "strict_bp": {
                  "maximum": 10000,
                  "minimum": 0,
                  "title": "Strict Bp",
                  "type": "integer"
                }
              },
              "required": [
                "attach_bp",
                "merge_bp",
                "strict_bp"
              ],
              "title": "VectorThresholds",
              "type": "object"
            },
            "window_hours": {
              "maximum": 168,
              "minimum": 1,
              "title": "Window Hours",
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "window_hours",
            "max_distance_km",
            "local",
            "remote"
          ],
          "title": "VectorSettings",
          "type": "object"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "simhash",
        "vector",
        "updated_at",
        "updated_by"
      ],
      "title": "ClusteringConfig",
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "description": "Counts over the status window (global rows + the caller tenant's own rows).",
      "properties": {
        "absorbed": {
          "minimum": 0,
          "title": "Absorbed",
          "type": "integer"
        },
        "anchor": {
          "minimum": 0,
          "title": "Anchor",
          "type": "integer"
        },
        "attach_geo": {
          "minimum": 0,
          "title": "Attach Geo",
          "type": "integer"
        },
        "attach_ref": {
          "minimum": 0,
          "title": "Attach Ref",
          "type": "integer"
        },
        "attach_vector": {
          "minimum": 0,
          "title": "Attach Vector",
          "type": "integer"
        },
        "embeddings_failed": {
          "minimum": 0,
          "title": "Embeddings Failed",
          "type": "integer"
        },
        "embeddings_pending": {
          "minimum": 0,
          "title": "Embeddings Pending",
          "type": "integer"
        },
        "extractions_reused": {
          "minimum": 0,
          "title": "Extractions Reused",
          "type": "integer"
        },
        "founded": {
          "minimum": 0,
          "title": "Founded",
          "type": "integer"
        },
        "merged_vector": {
          "minimum": 0,
          "title": "Merged Vector",
          "type": "integer"
        },
        "near_duplicate": {
          "minimum": 0,
          "title": "Near Duplicate",
          "type": "integer"
        },
        "same_hazard": {
          "minimum": 0,
          "title": "Same Hazard",
          "type": "integer"
        },
        "same_source_duplicates": {
          "minimum": 0,
          "title": "Same Source Duplicates",
          "type": "integer"
        },
        "simhash_near_duplicates": {
          "minimum": 0,
          "title": "Simhash Near Duplicates",
          "type": "integer"
        }
      },
      "required": [
        "simhash_near_duplicates",
        "same_source_duplicates",
        "extractions_reused",
        "anchor",
        "same_hazard",
        "founded",
        "attach_geo",
        "attach_ref",
        "attach_vector",
        "near_duplicate",
        "absorbed",
        "merged_vector",
        "embeddings_pending",
        "embeddings_failed"
      ],
      "title": "ClusteringCounts",
      "type": "object"
    },
    "vector_backend": {
      "additionalProperties": false,
      "description": "Which similarity backends are available: the local term vectors always; a remote profile\nonly with pgvector, the litellm provider and a provisioned profile (else ``remote_reason``).",
      "properties": {
        "local_profile": {
          "const": "local-terms-v1",
          "title": "Local Profile",
          "type": "string"
        },
        "pgvector": {
          "title": "Pgvector",
          "type": "boolean"
        },
        "remote": {
          "anyOf": [
            {
              "additionalProperties": false,
              "description": "The active remote embedding profile (opt-in ``SIGNALS_EMBED_PROVIDER=litellm``).",
              "properties": {
                "alias": {
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
                  "title": "Alias",
                  "type": "string"
                },
                "dims": {
                  "maximum": 4000,
                  "minimum": 1,
                  "title": "Dims",
                  "type": "integer"
                },
                "pending": {
                  "minimum": 0,
                  "title": "Pending",
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "active",
                    "backfilling"
                  ],
                  "title": "Status",
                  "type": "string"
                },
                "storage": {
                  "pattern": "^(vector|halfvec)\\([1-9][0-9]{0,3}\\)$",
                  "title": "Storage",
                  "type": "string"
                }
              },
              "required": [
                "alias",
                "dims",
                "storage",
                "status",
                "pending"
              ],
              "title": "RemoteEmbeddingProfile",
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote_reason": {
          "anyOf": [
            {
              "enum": [
                "provider_local",
                "pgvector_missing",
                "profile_missing",
                "key_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Remote Reason"
        }
      },
      "required": [
        "pgvector",
        "local_profile",
        "remote",
        "remote_reason"
      ],
      "title": "ClusteringBackend",
      "type": "object"
    },
    "window_days": {
      "minimum": 1,
      "title": "Window Days",
      "type": "integer"
    }
  },
  "required": [
    "config",
    "vector_backend",
    "window_days",
    "counts"
  ],
  "title": "ClusteringStatus",
  "type": "object",
  "x-keelson-source": "keelson_contracts.signals.ClusteringStatus"
}
