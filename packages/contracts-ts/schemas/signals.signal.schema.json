                "coordinates"
              ],
              "title": "MultiPoint",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "coordinates": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
