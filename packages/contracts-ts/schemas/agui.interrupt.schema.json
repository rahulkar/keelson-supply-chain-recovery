{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One interrupt reported in ``RUN_FINISHED{outcome: interrupt}``.",
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "reason": {
      "enum": [
        "approach",
        "approval"
      ],
      "title": "Reason",
      "type": "string"
    },
    "responseSchema": {
      "additionalProperties": true,
      "title": "Responseschema",
      "type": "object"
    }
  },
  "required": [
    "id",
    "reason",
    "message",
    "responseSchema"
  ],
  "title": "InterruptSpec",
  "type": "object",
  "x-keelson-source": "keelson_contracts.agui.InterruptSpec"
}
