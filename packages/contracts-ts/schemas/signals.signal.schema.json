                            "type": "array"
                          },
                          "type": {
                            "const": "Point",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "Point",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "items": {
                              "maxItems": 2,
                              "minItems": 2,
                              "prefixItems": [
                                {
                                  "maximum": 180,
                                  "minimum": -180,
                                  "type": "number"
                                },
                                {
                                  "maximum": 90,
                                  "minimum": -90,
                                  "type": "number"
                                }
                              ],
                              "type": "array"
                            },
                            "minItems": 1,
                            "title": "Coordinates",
                            "type": "array"
                          },
                          "type": {
                            "const": "MultiPoint",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "MultiPoint",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "items": {
                              "maxItems": 2,
                              "minItems": 2,
                              "prefixItems": [
                                {
                                  "maximum": 180,
                                  "minimum": -180,
                                  "type": "number"
                                },
                                {
                                  "maximum": 90,
                                  "minimum": -90,
                                  "type": "number"
                                }
                              ],
                              "type": "array"
                            },
                            "minItems": 2,
                            "title": "Coordinates",
                            "type": "array"
                          },
                          "type": {
                            "const": "LineString",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "LineString",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "maxItems": 2,
                                "minItems": 2,
                                "prefixItems": [
                                  {
                                    "maximum": 180,
                                    "minimum": -180,
                                    "type": "number"
                                  },
                                  {
                                    "maximum": 90,
                                    "minimum": -90,
                                    "type": "number"
                                  }
                                ],
                                "type": "array"
                              },
                              "minItems": 2,
                              "type": "array"
                            },
                            "minItems": 1,
                            "title": "Coordinates",
                            "type": "array"
                          },
                          "type": {
                            "const": "MultiLineString",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "MultiLineString",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "maxItems": 2,
                                "minItems": 2,
                                "prefixItems": [
                                  {
                                    "maximum": 180,
                                    "minimum": -180,
                                    "type": "number"
                                  },
                                  {
                                    "maximum": 90,
                                    "minimum": -90,
                                    "type": "number"
                                  }
                                ],
                                "type": "array"
                              },
                              "minItems": 4,
                              "type": "array"
                            },
                            "minItems": 1,
                            "title": "Coordinates",
                            "type": "array"
                          },
                          "type": {
                            "const": "Polygon",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "Polygon",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "items": {
                              "items": {
                                "items": {
                                  "maxItems": 2,
                                  "minItems": 2,
                                  "prefixItems": [
                                    {
                                      "maximum": 180,
                                      "minimum": -180,
                                      "type": "number"
                                    },
                                    {
                                      "maximum": 90,
                                      "minimum": -90,
                                      "type": "number"
                                    }
                                  ],
                                  "type": "array"
                                },
                                "minItems": 4,
                                "type": "array"
                              },
                              "minItems": 1,
                              "type": "array"
                            },
                            "minItems": 1,
                            "title": "Coordinates",
                            "type": "array"
                          },
                          "type": {
                            "const": "MultiPolygon",
                            "title": "Type",
                            "type": "string"
                          }
                        },
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "title": "MultiPolygon",
                        "type": "object"
                      }
                    ],
                    "discriminator": {
                      "mapping": {
                        "LineString": "#/$defs/LineString",
                        "MultiLineString": "#/$defs/MultiLineString",
                        "MultiPoint": "#/$defs/MultiPoint",
                        "MultiPolygon": "#/$defs/MultiPolygon",
                        "Point": "#/$defs/Point",
                        "Polygon": "#/$defs/Polygon"
                      },
                      "propertyName": "type"
                    }
                  },
                  "minItems": 1,
                  "title": "Geometries",
                  "type": "array"
                },
                "type": {
                  "const": "GeometryCollection",
                  "title": "Type",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "geometries"
              ],
              "title": "GeometryCollection",
              "type": "object"
            }
          ],
          "discriminator": {
            "mapping": {
              "GeometryCollection": "#/$defs/GeometryCollection",
              "LineString": "#/$defs/LineString",
              "MultiLineString": "#/$defs/MultiLineString",
              "MultiPoint": "#/$defs/MultiPoint",
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          }
        },
        {
          "type": "null"
        }
