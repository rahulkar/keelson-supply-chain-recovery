# Normalise line endings in the repository (LF), keep Windows scripts CRLF.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.parquet binary
*.zip binary
*.woff binary
*.woff2 binary
*.pmtiles binary
