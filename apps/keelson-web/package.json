{
  "name": "@keelson/web",
  "version": "0.1.0",
  "private": true,
  "description": "Keelson web app (Next.js 16 App Router): home composer, case thread with live thinking timeline, render blocks and canvas.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev -p 3000",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/inter": "5.3.0",
    "@keelson/contracts": "workspace:*",
    "@keelson/tokens": "workspace:*",
    "@keelson/ui": "workspace:*",
    "@keelson/viz": "workspace:*",
    "lucide-react": "1.52.0",
    "maplibre-gl": "6.12.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
