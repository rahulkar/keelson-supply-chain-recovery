# Keelson + Merxa local stack - environment template.
# DO NOT copy secrets by hand: run scripts/init.ps1 (Windows) or scripts/init.sh, which
# generate .env with random values (idempotent; existing values are never overwritten).
# .env is gitignored. All values below are placeholders.
#
# GEMINI_API_KEY is intentionally NOT in .env: set it in your host environment
# (e.g. `setx GEMINI_API_KEY <key>` then open a new terminal). Only litellm receives it.
#
# Precedence: docker compose prefers variables from the shell environment over .env.
# scripts/up.ps1 strips host variables that shadow .env (e.g. a stray LITELLM_MASTER_KEY).

# -- general -------------------------------------------------------------------------
# public base domain (dev: localhost)
PUBLIC_BASE_DOMAIN=localhost
# Caddy port on the host
HTTP_PORT=80
# 1 = demo features (persona switcher, demo director)
DEMO_MODE=1
# Keycloak demo clients/users enabled (true|false)
DEMO_ENABLED=true
# Merxa seed profile (full = the demo: 451 stores, 180 SKUs | small = fast tests)
SEED_PROFILE=full
BRAND_ENGINE_NAME=Keelson
BRAND_VENDOR_NAME=Merxa
# 1 = expose Keycloak /admin + master realm on auth.localhost
DEV_ALLOW_KC_ADMIN=0

# -- base map (M8, docs/contracts/127-m8-basemap.md) ---------------------------------------
# network map background, runtime (keelson-web): auto | protomaps | openfreemap | offline
# auto = self-hosted Protomaps when installed (basemap-fetch), else OpenFreeMap, else the built-in outline
# KEELSON_BASEMAP=auto
# build time (keelson-web image CSP): third-party map origins, space separated https origins, or none
# KEELSON_CSP_MAP_ORIGINS=https://tiles.openfreemap.org
# basemap-fetch: lite (~29 MB) | standard (~59 MB) | detail (~203 MB)
# BASEMAP_PROFILE=standard
# Protomaps daily build: latest or YYYYMMDD (builds are kept for about two months)
# BASEMAP_BUILD=latest
# BASEMAP_MAX_MB=300

# -- pg-core (Postgres 18 + PostGIS + pgvector) -----------------------------------------
PG_CORE_SUPERPASSWORD=change-me-postgres-superuser
KEELSON_DB_PASSWORD=change-me-keelson-db
ADK_DB_PASSWORD=change-me-adk-db
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# -- LiteLLM (AI gateway) ----------------------------------------------------------------
LITELLM_DB_PASSWORD=change-me-litellm-db
# must start with sk-; bootstrap + engine-api only
LITELLM_MASTER_KEY=sk-change-me-master-key
# encrypts provider keys in pg-litellm; back it up with the DB
LITELLM_SALT_KEY=change-me-salt-NEVER-ROTATE
# LiteLLM admin UI (user admin)
LITELLM_UI_PASSWORD=change-me-litellm-ui

# -- Merxa (mock vendor ERP) -------------------------------------------------------------
MERXA_DB_PASSWORD=change-me-merxa-db

# -- Valkey -------------------------------------------------------------------------------
VALKEY_PASSWORD=change-me-valkey

# -- Keycloak (realms keelson + merxa) ------------------------------------------------------
# bootstrap admin "admin" (master realm)
KC_ADMIN_PASSWORD=change-me-keycloak-admin
# realm keelson, client keelson-bff
KEELSON_BFF_CLIENT_SECRET=change-me-keelson-bff
# realm keelson, client keelson-demo
KEELSON_DEMO_CLIENT_SECRET=change-me-keelson-demo
# realm merxa, client merxa-web
MERXA_WEB_CLIENT_SECRET=change-me-merxa-web
# realm merxa, client merxa-demo
MERXA_DEMO_CLIENT_SECRET=change-me-merxa-demo
# all seeded personas, both realms
DEMO_USER_PASSWORD=change-me-demo-personas

# -- application secrets --------------------------------------------------------------------
# engine-api + merxa-api session signing
SESSION_SECRET=change-me-session-secret-64-chars
# X-Demo-Access for non-localhost demos
DEMO_ACCESS_SECRET=change-me-demo-access
# engine -> optimizer
OPTIMIZER_SHARED_SECRET=change-me-optimizer-shared
# Phoenix auth (profile obs)
PHOENIX_SECRET=change-me-phoenix-secret-32-chars-min
# Merxa -> Keelson Standard Webhooks secret (connector merxa, tenant demo-retail)
MERXA_WEBHOOK_SECRET=whsec_change-me
# HMAC secret for Merxa signed snapshot download URLs
MERXA_SNAPSHOT_SECRET=change-me-merxa-snapshot
# engine -> signal-hub service JWT secret (HS256)
SIGNAL_HUB_SHARED_SECRET=change-me-signal-hub-shared
# pg-core role 'signals' (signal-hub database)
SIGNALS_DB_PASSWORD=change-me-signals-db
# Engine LLM record/replay: off | record | replay | record_or_replay (dev/demo default record_or_replay; production must be off)
# LLM_REPLAY_MODE=record_or_replay
# Dedicated LiteLLM virtual key for signal-hub news extraction (extract-fast + guard-default only); provisioned by bootstrap in M7
# LITELLM_SIGNALS_KEY=
# M8 signal clustering (docs/contracts/123): local term vectors by default; "litellm" opts into remote
# embeddings (pgvector + the hub key gets the embed alias) for the background merge pass only.
# SIGNALS_EMBED_PROVIDER=local
# SIGNALS_EMBED_ALIAS=embed-default
# SIGNALS_EMBED_DIMS=1536
# SIGNALS_EMBED_INCLUDE_HEADLINE=0
# SIGNALS_CLUSTER_MAINTENANCE_S=60
# SIGNALS_VECTOR_VERSION=

# -- M8 Evals UI (docs/contracts/128-m8-evals-ui.md) ----------------------------------------------
# engine <-> evals-runner job API bearer token (empty = the in-app runner is off; profile evals)
EVALS_RUNNER_TOKEN=change-me-evals-runner-token
# 1 = allow live (model-calling) eval runs from the UI (platform admins, typed confirmation, budget); replay runs need nothing
# EVALS_LIVE_ENABLED=0
# hard caps of one live eval run's budget (tokens; integer micro-USD)
# EVALS_LIVE_MAX_TOKENS=3000000
# EVALS_LIVE_MAX_COST_MICROUSD=5000000

# -- Signal Hub feeds (M8, docs/contracts/124-m8-signal-feeds.md) -------------------------------
# Adapters the poller may run (the operator's allow-list; nothing else ever leaves through egress).
# GDELT is listed but stays paused until a workspace opts in (Signals admin). MeteoAlarm is left out
# by default: review the MeteoAlarm / national weather-service redistribution terms before enabling it,
# then add "meteoalarm" here and name the country feeds (slugs of feeds.meteoalarm.org).
# SIGNAL_ADAPTERS=gdacs,usgs,rss,nhc,copernicus_ems,ofac,gdelt
# METEOALARM_COUNTRIES=netherlands,germany,poland,united-kingdom
# Feed URL overrides (the defaults are the public endpoints):
# NHC_URL=https://www.nhc.noaa.gov/CurrentStorms.json
# COPERNICUS_EMS_URL=https://rapidmapping.emergency.copernicus.eu/backend/dashboard-api/public-activations-info/?limit=50
# OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
# OFAC_ALT_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/ALT.CSV
# OFAC_ADD_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/ADD.CSV
# GDELT_LASTUPDATE_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt

# -- M8 mapping compiler + proposed mappings (docs/contracts/121; all optional) -------------
# Tier-A crawl engine: duckdb (compiler, default) | interpreter (the M7 path, kill switch)
# SCN_MAPPING_ENGINE=duckdb
# Keep a crawl's raw pages for staged previews (1); 0 = raw data only inside the crawl's DuckDB session
# SCN_RAW_STAGING=1
# Raw JSON one crawl may fetch (bytes, default 512 MiB); beyond it the crawl fails too_many_rows
# SCN_RAW_MAX_BYTES=536870912
# Per DuckDB session (crawl / preview); compose caps engine-api at 128
# DUCKDB_MEMORY_LIMIT_MB=256
# DUCKDB_THREADS=2
# Items per source a staged preview maps in engine-api
# MAPPING_PREVIEW_MAX_ITEMS=20000
# Proposals: auto (rules + AI when available) | heuristic (rules only; compose default) | off
# MAPPING_PROPOSER=heuristic
# LiteLLM alias of the mapping_proposer agent (Flash / Flash-Lite only; Pro is refused)
# MAPPING_PROPOSER_ALIAS=fast-default
# Sampling budget: read calls per proposal, items per sampled page (caps: may only lower the defaults)
# MAPPING_PROPOSE_MAX_CALLS=24
# MAPPING_PROPOSE_SAMPLE_SIZE=20
# Whole proposal / AI step timeouts (seconds) and the profile data block sent to the model (characters, at most 24000)
# MAPPING_PROPOSE_TIMEOUT_S=120
# MAPPING_PROPOSE_LLM_TIMEOUT_S=60
# MAPPING_PROPOSE_MAX_PROFILE_CHARS=24000

# -- M8 adapter sidecar demo "Fernhill ERP" (compose profile adapters, docs/contracts/122) ----
# static key Keelson stores when registering the connector (header X-Adapter-Key); >= 32 chars
FERNHILL_API_KEY=change-me-fernhill-api-key-32-chars
# admin key for /v1/admin/* (demo reset, e2e read-back); never given to Keelson; >= 32 chars
FERNHILL_ADMIN_KEY=change-me-fernhill-admin-key-32-chars
# HMAC secret for the sidecar's signed Parquet part URLs; >= 32 chars
FERNHILL_SNAPSHOT_SECRET=change-me-fernhill-snapshot-secret-32
