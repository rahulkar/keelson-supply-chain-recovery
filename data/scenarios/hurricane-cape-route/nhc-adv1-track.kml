<?xml version="1.0" encoding="UTF-8"?>
<!-- SIMULATED demo data (Keelson pack hurricane-cape-route): forecast track of the fictional Hurricane
     ALBATROSS, advisory 7, shaped like an NHC forecast-track KML. Not an NHC product. -->
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>AL992026 (Advisory #7) - Forecast Track (SIMULATED)</name>
  <Folder id="Forecast Track">
       <Placemark>
          <styleUrl>#72_line</styleUrl>
          <LineString><coordinates> -14.400,9.300,0 -15.700,10.500,0 -17.000,11.800,0 -18.200,13.300,0 -19.200,15.000,0 -20.600,18.600,0 </coordinates></LineString>
          <ExtendedData><Data name="maxWindKnots"><value>70</value></Data></ExtendedData>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>12 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -15.70,10.50,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>24 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -17.00,11.80,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>36 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -18.20,13.30,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>48 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -19.20,15.00,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>72 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -20.60,18.60,0 </coordinates></Point>
       </Placemark>
  </Folder>
</Document>
</kml>
