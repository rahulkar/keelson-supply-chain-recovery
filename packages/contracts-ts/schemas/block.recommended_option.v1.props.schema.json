{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``recommended_option@1``.\n\nM4 additions (omitted at their defaults): ``unconfirmed`` values and ``what_if``. While\neither is set, an ``apply`` action must be disabled (with its reason); a\n``confirm_assumptions`` action needs ``unconfirmed`` values and ``promote`` needs\n``what_if``.\n\nM5 addition (omitted while unset): ``remediation_mix`` — apply vs guide line counts. When\nit is set, an enabled ``apply`` needs ``apply_lines > 0``.\n\nM7 addition (omitted while unset): ``advisory`` — the option was computed on crawled data.\nApplying stays possible (per-op, with approval as usual).",
  "properties": {
    "actions": {
      "items": {
        "additionalProperties": false,
        "description": "A button on the recommended option; disabled actions must say why.\n\nM4 adds ``confirm_assumptions`` (confirm the unconfirmed values, re-runs impact +\nsimulate) and ``promote`` (turn a what-if case into an actual one).",
        "properties": {
          "disabled_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Disabled Reason"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "type": {
            "enum": [
              "apply",
              "guide",
              "confirm_assumptions",
              "promote"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "label",
          "enabled"
        ],
        "title": "OptionAction",
        "type": "object"
      },
      "title": "Actions",
      "type": "array"
    },
    "advisory": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "M7: the plan was built on data that is not a consistent snapshot (a tier-A crawl), so the\noptions are advisory. ``text`` is what the UI shows; ``as_of_range`` is when the data was\nread.",
          "properties": {
            "as_of_range": {
              "additionalProperties": false,
              "description": "When a crawled snapshot's data was read: the first and the last page (wire keys ``from`` /\n``to``; Python attributes ``from_`` / ``to``). ``to`` is never before ``from``.",
              "properties": {
                "from": {
                  "format": "date-time",
                  "title": "From",
                  "type": "string"
                },
                "to": {
                  "format": "date-time",
                  "title": "To",
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "title": "AsOfRange",
              "type": "object"
            },
            "reason": {
              "const": "crawled_snapshot",
              "title": "Reason",
              "type": "string"
            },
            "text": {
              "minLength": 1,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "reason",
            "text",
            "as_of_range"
          ],
          "title": "Advisory",
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "alternatives": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "one_liner": {
            "title": "One Liner",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "one_liner"
        ],
        "title": "AlternativeOption",
        "type": "object"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kpis": {
          "items": {
            "additionalProperties": false,
            "description": "One KPI tile. ``value``/``delta`` are integers in ``unit``.",
            "properties": {
              "delta": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Delta"
              },
              "key": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "title": "Key",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "title": "Label",
                "type": "string"
              },
              "preliminary": {
                "title": "Preliminary",
                "type": "boolean"
              },
              "prov": {
                "description": "Where a number or statement comes from (plan §3.3).",
                "enum": [
                  "fact",
                  "inference",
                  "assumption",
                  "simulated",
                  "decision",
                  "committed"
                ],
                "title": "Provenance",
                "type": "string"
              },
              "unit": {
                "enum": [
                  "units",
                  "eur_cents",
                  "days",
                  "pct_bp",
                  "count"
                ],
                "title": "Unit",
                "type": "string"
              },
              "value": {
                "title": "Value",
                "type": "integer"
              }
            },
            "required": [
              "key",
              "label",
              "value",
              "unit",
              "prov",
              "preliminary"
            ],
            "title": "KpiItem",
            "type": "object"
          },
          "title": "Kpis",
          "type": "array"
        },
        "summary_bullets": {
          "items": {
            "type": "string"
          },
          "title": "Summary Bullets",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary_bullets",
        "kpis"
      ],
      "title": "OptionSummary",
      "type": "object"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "remediation_mix": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "How the option's changes split (M5, ``95`` §2): lines the connectors apply for the user\nand lines the user performs with a guided checklist (\"Apply 3 changes for me · Guide me\nthrough 2\").",
          "properties": {
            "apply_lines": {
              "minimum": 0,
              "title": "Apply Lines",
              "type": "integer"
            },
            "guide_lines": {
              "minimum": 0,
              "title": "Guide Lines",
              "type": "integer"
            }
          },
          "required": [
            "apply_lines",
            "guide_lines"
          ],
          "title": "RemediationMix",
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unconfirmed": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "description": "A value the plan relies on that a human must confirm first (\"Confirm before applying\").",
        "properties": {
          "key": {
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "value_text": {
            "minLength": 1,
            "title": "Value Text",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "value_text",
          "source"
        ],
        "title": "UnconfirmedValue",
        "type": "object"
      },
      "title": "Unconfirmed",
      "type": "array"
    },
    "what_if": {
      "default": false,
      "title": "What If",
      "type": "boolean"
    }
  },
  "required": [
    "plan_version",
    "option",
    "alternatives",
    "actions"
  ],
  "title": "RecommendedOptionProps",
  "type": "object",
  "x-keelson-source": "keelson_contracts.blocks.RecommendedOptionProps"
}
