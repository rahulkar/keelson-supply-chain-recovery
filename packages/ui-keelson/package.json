{
  "name": "@keelson/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Keelson presentational, accessible UI primitives (Base UI under the hood): composer, thinking timeline, provenance chips, canvas panel and friends.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@keelson/tokens": "workspace:*",
    "clsx": "2.1.1",
    "lucide-react": "1.52.0",
    "motion": "13.5.1"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
