# Build context for apps/keelson-web/Dockerfile (context = repo root). BuildKit uses this file
# instead of the root .dockerignore: only the pnpm workspace manifests, the four @keelson/*
# packages and this app are sent; Python services, secrets and .env never are.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/keelson-web/
!packages/tokens-keelson/
!packages/ui-keelson/
!packages/viz/
!packages/contracts-ts/
**/node_modules
**/.next
**/.turbo
**/coverage
# generated by scripts/copy-maplibre-worker.mjs during the image build
apps/keelson-web/public/maplibre
**/*.tsbuildinfo
