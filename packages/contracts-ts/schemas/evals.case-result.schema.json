{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One eval case's outcome (``eval_case_result.result``; ``GET …/runs/{id}/cases/{case}``).",
  "properties": {
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "checks": {
      "items": {
        "additionalProperties": false,
        "description": "One assertion of a turn or of the case (``<turn>.<check>`` / ``case.<check>``).",
        "properties": {
          "detail": {
            "default": "",
            "maxLength": 2000,
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "soft": {
            "default": false,
            "title": "Soft",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ok"
        ],
        "title": "EvalCheck",
        "type": "object"
      },
      "maxItems": 300,
      "title": "Checks",
      "type": "array"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "engine": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "What the engine metered for the linked Keelson case (in-app runs; authoritative).",
          "properties": {
            "cost_microusd": {
              "minimum": 0,
              "title": "Cost Microusd",
              "type": "integer"
            },
            "llm_calls_live": {
              "minimum": 0,
              "title": "Llm Calls Live",
              "type": "integer"
            },
            "llm_calls_replayed": {
              "minimum": 0,
              "title": "Llm Calls Replayed",
              "type": "integer"
            },
            "replay_misses": {
              "minimum": 0,
              "title": "Replay Misses",
              "type": "integer"
            },
            "tokens_live": {
              "minimum": 0,
              "title": "Tokens Live",
              "type": "integer"
            }
          },
          "required": [
            "llm_calls_live",
            "llm_calls_replayed",
            "tokens_live",
            "replay_misses",
            "cost_microusd"
