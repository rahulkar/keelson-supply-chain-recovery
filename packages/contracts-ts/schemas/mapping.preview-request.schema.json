{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST /api/admin/connectors/{slug}/mappings/read/preview``. ``source: live`` pages at most\n``max_pages`` page(s) per distinct source with the reader credentials; ``staged`` maps the raw\npages of the last crawl stored in Keelson (no vendor call; works with the connector disabled),\nat most ``max_items_per_source`` items per source.",
  "properties": {
    "mapping": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mapping"
    },
    "max_items_per_source": {
      "default": 20000,
      "maximum": 50000,
      "minimum": 1,
      "title": "Max Items Per Source",
      "type": "integer"
    },
    "max_pages": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Pages",
      "type": "integer"
    },
    "sample": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Sample",
      "type": "integer"
    },
    "source": {
      "default": "live",
      "enum": [
        "live",
        "staged"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "title": "ReadPreviewRequest",
  "type": "object",
  "x-keelson-source": "keelson_contracts.mapping.ReadPreviewRequest"
}
