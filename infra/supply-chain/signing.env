# Signature policy for Keelson release images and release files (KEY=value only, no spaces, no quotes).
# Read by scripts/supply-chain/lib/verify.sh (verify-images.sh, compose-release.sh, scripts/cloudrun/deploy.sh);
# docs/supply-chain.md. Not a secret: it names WHO may sign, it holds no key material.
#
# Keyless (Sigstore): images and keelson-release.env are signed by .github/workflows/release.yml with the
# GitHub Actions OIDC identity, recorded in the public Rekor log. Verification pins the identity to this
# repository, that workflow file, a push to main or a vX.Y.Z tag; a signature from any other workflow,
# branch, fork, pull request or trigger is rejected.
SIGNER_MODE=keyless
SIGNER_OIDC_ISSUER=https://token.actions.githubusercontent.com
SIGNER_IDENTITY_REGEXP=^https://github\.com/rahulkar/keelson-supply-chain-recovery/\.github/workflows/release\.yml@refs/(heads/main|tags/v[0-9]+\.[0-9]+\.[0-9]+)$
SIGNER_REPOSITORY=rahulkar/keelson-supply-chain-recovery
SIGNER_TRIGGER=push
# Key mode (SIGNER_MODE=key + SIGNER_KEY=<public key file>) exists for the offline e2e test only;
# deploy.sh warns loudly whenever it is used.
SIGNER_KEY=
# Where release.yml pushes images; release files may only reference images below this prefix.
RELEASE_REGISTRY=ghcr.io/rahulkar/keelson
# SLSA v1 build provenance (actions/attest-build-provenance) must verify too.
REQUIRE_PROVENANCE=1
# cosign used when neither $COSIGN_BIN nor `cosign` on PATH exists (docker run, files mounted read-only).
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3@sha256:9e5c2f2edc34351160407ca3416c61855bdf9403c3c5936e0f0be7fc261611b8
