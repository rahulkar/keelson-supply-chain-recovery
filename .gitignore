# ─────────────────────────── secrets & local environment ───────────────────────────
# Generated by scripts/init.* — never commit real secrets.
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*.key

# Client source material (confidential, kept out of the repository)
*.docx
*.pptx
*.xlsx

# ─────────────────────────── Python ───────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/

# ─────────────────────────── Node / Next.js ───────────────────────────
node_modules/
.pnpm-store/
.next/
.turbo/
out/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
pnpm-debug.log*

# ─────────────────────────── tests & generated artifacts ───────────────────────────
playwright-report/
test-results/
e2e/playwright/artifacts/
evals/results/*
!evals/results/.gitkeep
apps/keelson-web/public/maplibre/

# ─────────────────────────── OS / editors ───────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.log
