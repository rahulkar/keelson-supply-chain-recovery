                        "maximum": 90,
                        "minimum": -90,
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "minItems": 2,
                  "title": "Coordinates",
                  "type": "array"
                },
                "type": {
                  "const": "LineString",
