{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One normalized observation (``100`` §2). ``tenant`` is ``None`` for global feed/news signals\nand set for tenant-origin ones (connected system, chat). ``geometry`` is ``None`` until an\nitem is geocoded (e.g. a supplier message matched only by ``location_refs``).",
  "properties": {
    "confidence_bp": {
      "maximum": 10000,
      "minimum": 0,
      "title": "Confidence Bp",
      "type": "integer"
    },
    "ends_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ends At"
    },
    "event_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Event Id"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "extracted_by": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Extracted By"
    },
    "geometry": {
      "anyOf": [
        {
          "anyOf": [
