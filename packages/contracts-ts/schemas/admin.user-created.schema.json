{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "setup": {
      "additionalProperties": false,
      "description": "How the new user sets a password. The temporary password itself is never returned or\nstored: ``link`` is a one-time action link (Keycloak execute-actions) when available;\n``instructions`` say what to do either way.",
      "properties": {
        "instructions": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Instructions",
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^\\s]*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Link"
        },
        "link_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Link Expires At"
        },
        "required_action": {
          "const": "UPDATE_PASSWORD",
          "default": "UPDATE_PASSWORD",
          "title": "Required Action",
          "type": "string"
        }
      },
      "required": [
        "link",
        "link_expires_at",
        "instructions"
      ],
      "title": "PasswordSetup",
      "type": "object"
    },
    "user": {
      "additionalProperties": false,
      "description": "A user holding the tenant attribute (``GET /api/admin/users``).",
      "properties": {
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created At"
        },
        "email": {
          "anyOf": [
            {
              "maxLength": 254,
              "pattern": "^[^@\\s]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "title": "Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "planner",
              "approver",
              "compliance",
              "tenant-admin",
              "platform-admin",
              "demo-presenter"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "tenants": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
            "type": "string"
          },
          "title": "Tenants",
          "type": "array"
        },
        "username": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "name",
        "enabled",
        "roles",
        "tenants",
        "created_at"
      ],
      "title": "AdminUser",
      "type": "object"
    }
  },
  "required": [
    "user",
    "setup"
  ],
  "title": "AdminUserCreated",
  "type": "object",
  "x-keelson-source": "keelson_contracts.admin.AdminUserCreated"
}
