# Keelson + Merxa local stack - environment template.
# DO NOT copy secrets by hand: run scripts/init.ps1 (Windows) or scripts/init.sh, which
# generate .env with random values (idempotent; existing values are never overwritten).
# .env is gitignored. All values below are placeholders.
#
# GEMINI_API_KEY is intentionally NOT in .env: set it in your host environment
# (e.g. `setx GEMINI_API_KEY <key>` then open a new terminal). Only litellm receives it.
#
# Precedence: docker compose prefers variables from the shell environment over .env.
# scripts/up.ps1 strips host variables that shadow .env (e.g. a stray LITELLM_MASTER_KEY).

# -- general -------------------------------------------------------------------------
# public base domain (dev: localhost)
PUBLIC_BASE_DOMAIN=localhost
# Caddy port on the host
HTTP_PORT=80
# 1 = demo features (persona switcher, demo director)
DEMO_MODE=1
# Keycloak demo clients/users enabled (true|false)
DEMO_ENABLED=true
# Merxa seed profile (full = the demo: 451 stores, 180 SKUs | small = fast tests)
SEED_PROFILE=full
BRAND_ENGINE_NAME=Keelson
BRAND_VENDOR_NAME=Merxa
# 1 = expose Keycloak /admin + master realm on auth.localhost
DEV_ALLOW_KC_ADMIN=0

# -- pg-core (Postgres 18 + PostGIS + pgvector) -----------------------------------------
PG_CORE_SUPERPASSWORD=change-me-postgres-superuser
KEELSON_DB_PASSWORD=change-me-keelson-db
ADK_DB_PASSWORD=change-me-adk-db
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# -- LiteLLM (AI gateway) ----------------------------------------------------------------
LITELLM_DB_PASSWORD=change-me-litellm-db
# must start with sk-; bootstrap + engine-api only
LITELLM_MASTER_KEY=sk-change-me-master-key
# encrypts provider keys in pg-litellm; back it up with the DB
LITELLM_SALT_KEY=change-me-salt-NEVER-ROTATE
# LiteLLM admin UI (user admin)
LITELLM_UI_PASSWORD=change-me-litellm-ui

# -- Merxa (mock vendor ERP) -------------------------------------------------------------
MERXA_DB_PASSWORD=change-me-merxa-db

# -- Valkey -------------------------------------------------------------------------------
VALKEY_PASSWORD=change-me-valkey

# -- Keycloak (realms keelson + merxa) ------------------------------------------------------
# bootstrap admin "admin" (master realm)
KC_ADMIN_PASSWORD=change-me-keycloak-admin
# realm keelson, client keelson-bff
KEELSON_BFF_CLIENT_SECRET=change-me-keelson-bff
# realm keelson, client keelson-demo
KEELSON_DEMO_CLIENT_SECRET=change-me-keelson-demo
# realm merxa, client merxa-web
MERXA_WEB_CLIENT_SECRET=change-me-merxa-web
# realm merxa, client merxa-demo
MERXA_DEMO_CLIENT_SECRET=change-me-merxa-demo
# all seeded personas, both realms
DEMO_USER_PASSWORD=change-me-demo-personas

# -- application secrets --------------------------------------------------------------------
# engine-api + merxa-api session signing
SESSION_SECRET=change-me-session-secret-64-chars
# X-Demo-Access for non-localhost demos
DEMO_ACCESS_SECRET=change-me-demo-access
# engine -> optimizer
OPTIMIZER_SHARED_SECRET=change-me-optimizer-shared
# Phoenix auth (profile obs)
PHOENIX_SECRET=change-me-phoenix-secret-32-chars-min
# Merxa -> Keelson Standard Webhooks secret (connector merxa, tenant demo-retail)
MERXA_WEBHOOK_SECRET=whsec_change-me
# HMAC secret for Merxa signed snapshot download URLs
MERXA_SNAPSHOT_SECRET=change-me-merxa-snapshot
# engine -> signal-hub service JWT secret (HS256)
SIGNAL_HUB_SHARED_SECRET=change-me-signal-hub-shared
# pg-core role 'signals' (signal-hub database)
SIGNALS_DB_PASSWORD=change-me-signals-db
# Engine LLM record/replay: off | record | replay | record_or_replay (dev/demo default record_or_replay; production must be off)
# LLM_REPLAY_MODE=record_or_replay
# Dedicated LiteLLM virtual key for signal-hub news extraction (extract-fast + guard-default only); provisioned by bootstrap in M7
# LITELLM_SIGNALS_KEY=

# -- M8 adapter sidecar demo "Fernhill ERP" (compose profile adapters, docs/contracts/122) ----
# static key Keelson stores when registering the connector (header X-Adapter-Key); >= 32 chars
FERNHILL_API_KEY=change-me-fernhill-api-key-32-chars
# admin key for /v1/admin/* (demo reset, e2e read-back); never given to Keelson; >= 32 chars
FERNHILL_ADMIN_KEY=change-me-fernhill-admin-key-32-chars
# HMAC secret for the sidecar's signed Parquet part URLs; >= 32 chars
FERNHILL_SNAPSHOT_SECRET=change-me-fernhill-snapshot-secret-32
