{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST /api/admin/users``: the engine creates the user with the active tenant's attribute,\na temporary password and the required action ``UPDATE_PASSWORD``.",
  "properties": {
    "email": {
      "maxLength": 254,
      "pattern": "^[^@\\s]{1,64}@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
      "title": "Email",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "planner",
          "approver",
          "compliance",
          "tenant-admin",
          "platform-admin",
          "demo-presenter"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "username": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$",
      "title": "Username",
      "type": "string"
    }
  },
  "required": [
    "username",
    "email",
    "name",
    "roles"
  ],
  "title": "AdminUserCreate",
  "type": "object",
  "x-keelson-source": "keelson_contracts.admin.AdminUserCreate"
}
