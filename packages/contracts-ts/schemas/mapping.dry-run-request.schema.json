{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``POST /api/admin/connectors/{slug}/mappings/action/dry-run``: render the tool call for a\nsample action (never executed); with ``run_readback`` the read-back query runs (read-only).",
  "properties": {
    "expected_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Version"
    },
    "op": {
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Op",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "run_readback": {
      "default": true,
      "title": "Run Readback",
      "type": "boolean"
    },
    "target_ref": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Ref"
    }
  },
  "required": [
    "op"
  ],
  "title": "ActionDryRunRequest",
  "type": "object",
  "x-keelson-source": "keelson_contracts.mapping.ActionDryRunRequest"
}
