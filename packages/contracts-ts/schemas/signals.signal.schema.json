                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "minItems": 1,
                  "title": "Coordinates",
                  "type": "array"
                },
                "type": {
                  "const": "MultiPolygon",
                  "title": "Type",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "title": "MultiPolygon",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A merged event footprint (e.g. TC track + cones). Members are simple geometries\n(nested collections are not allowed, per RFC 7946 §3.1.8 guidance).",
              "properties": {
                "geometries": {
                  "items": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "coordinates": {
                            "maxItems": 2,
                            "minItems": 2,
                            "prefixItems": [
                              {
