# Cloud Run deployment pins (sourced by scripts/cloudrun/deploy.sh; KEY=value only, no spaces).
#
# Cloud SQL extension versions are Cloud SQL's own for POSTGRES_18, taken from
# https://docs.cloud.google.com/sql/docs/postgres/extensions (page last updated 2026-09-30).
# The db-init job creates the extensions with exactly these versions and fails if Cloud SQL
# offers different ones (re-check the page and update this file + pg-core together).
# NOTE: the local pg-core image currently runs PostGIS 3.6.4 / pgvector 0.8.7 / pgcrypto 1.4,
# i.e. it is NOT aligned with these pins (see docs/cloud-run.md, "What differs from local").
CLOUDSQL_DATABASE_VERSION=POSTGRES_18
PIN_POSTGIS=3.6.0
PIN_VECTOR=0.8.5
PIN_BTREE_GIST=1.8
PIN_PGCRYPTO=1.3

# Memorystore for Valkey: same major as the local valkey/valkey:8-alpine.
VALKEY_ENGINE_VERSION=VALKEY_8_0

# Third-party images (same tags as compose.yaml); mirrored into Artifact Registry because
# Cloud Run only pulls from Artifact Registry / Docker Hub.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0@sha256:b0f60d489d51c5d113390bdf5461d4c06e6051be026c05549f2e1e10ec352bcc
LITELLM_IMAGE=ghcr.io/berriai/litellm-non_root:1.104.0@sha256:37066242e6b8327fdd627682a66a9ae2a599553b4d5a84c905c6d8b9eb35c01e
KC_CONFIG_IMAGE=adorsys/keycloak-config-cli:6.5.1-26@sha256:1b22dfaa9ae0c71f74b0342f9221a6510f272da5def683dbba26a98e6b1b1411
POSTGRES_CLIENT_IMAGE=postgres:18.6-trixie@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
PHOENIX_IMAGE=arizephoenix/phoenix:version-20.20.0@sha256:3a2e5a049f706f29c7b13bd82bcd94101bb10701874ce134ec9eb7f0299741aa
