<?xml version="1.0" encoding="UTF-8"?>
<!-- SIMULATED demo data (Keelson pack hurricane-cape-route): forecast track of the fictional Hurricane
     ALBATROSS, advisory 8, shaped like an NHC forecast-track KML. Not an NHC product. -->
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
<Document>
  <name>AL992026 (Advisory #8) - Forecast Track (SIMULATED)</name>
  <Folder id="Forecast Track">
       <Placemark>
          <styleUrl>#72_line</styleUrl>
          <LineString><coordinates> -15.000,9.900,0 -16.350,11.150,0 -17.600,12.550,0 -18.700,14.150,0 -19.550,15.900,0 -20.850,19.550,0 </coordinates></LineString>
          <ExtendedData><Data name="maxWindKnots"><value>100</value></Data></ExtendedData>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>12 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -16.35,11.15,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>24 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -17.60,12.55,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>36 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -18.70,14.15,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>48 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -19.55,15.90,0 </coordinates></Point>
       </Placemark>
       <Placemark>
          <description><![CDATA[<table><tr><td>72 hr Forecast</td></tr></table>]]></description>
          <styleUrl>#m_point</styleUrl>
          <Point><coordinates> -20.85,19.55,0 </coordinates></Point>
       </Placemark>
  </Folder>
</Document>
</kml>
