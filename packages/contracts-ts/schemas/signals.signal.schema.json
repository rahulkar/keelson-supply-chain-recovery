                      "minimum": -180,
                      "type": "number"
                    },
                    {
                      "maximum": 90,
                      "minimum": -90,
                      "type": "number"
                    }
                  ],
                  "title": "Coordinates",
                  "type": "array"
                },
                "type": {
                  "const": "Point",
                  "title": "Type",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "title": "Point",
              "type": "object"
            },
            {
